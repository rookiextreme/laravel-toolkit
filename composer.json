{
    "name": "rookiextreme/laravel-toolkit",
    "description": "Wrapper for commonly used code for a much shorter syntax in controllers and such",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rookiextreme\\LaravelToolkit\\": "src/"
        }
    },
    "authors": [
        {
            "name": "rookiextreme"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "orchestra/testbench": "^11.1"
    },
    "require": {
        "illuminate/http": "^13.24"
    },
    "scripts": {
        "test": "phpunit",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra" : {
        "laravel": {
            "providers": [
                "Rookiextreme\\LaravelToolkit\\Providers\\ToolkitServiceProvider"
            ],
            "aliases": {

            }
        }
    }
}